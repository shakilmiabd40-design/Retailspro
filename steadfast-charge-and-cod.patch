diff --git a/src/server/courier/steadfast-status.ts b/src/server/courier/steadfast-status.ts
index 2d78fc8..f1edb3a 100644
--- a/src/server/courier/steadfast-status.ts
+++ b/src/server/courier/steadfast-status.ts
@@ -162,3 +162,17 @@ export function readCourierPaidAmount(event: Record<string, unknown> | null | un
   if (changedCod !== null) return changedCod;
   return readPaidAmount(consignment) ?? readPaidAmount(event);
 }
+
+/**
+ * The courier's delivery charge. Steadfast names it `delivery_charge` on webhooks (one SDK documents
+ * `delivery_fee`). Zero or missing means "not reported yet" — Steadfast sends 0 on the early statuses
+ * and sometimes on a partial delivery — so it returns `null` and must never overwrite a known charge.
+ */
+export function readDeliveryCharge(source: Record<string, unknown> | null | undefined): number | null {
+  if (!source) return null;
+  for (const key of ["delivery_charge", "deliveryCharge", "delivery_fee", "deliveryFee", "charge"]) {
+    const value = toAmount(source[key]);
+    if (value !== null && value > 0) return value;
+  }
+  return null;
+}
